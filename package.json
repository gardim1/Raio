{
  "name": "raio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first desktop companion that shows where an AI coding agent works in a project.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-product-bundle.mjs",
    "dev:harness": "vite --open /harness.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
